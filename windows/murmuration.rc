#include <windows.h>
#include "version.h"

// Embedded manifest (the linker's own is turned off)
1 RT_MANIFEST "murmuration.manifest"

// String 1 is the name Windows shows in Screen Saver Settings
STRINGTABLE
BEGIN
    1 "Murmuration"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION MURMURATION_VERSION_NUM
PRODUCTVERSION MURMURATION_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Murmuration contributors"
            VALUE "FileDescription", "Murmuration screensaver"
            VALUE "FileVersion", MURMURATION_VERSION_STR
            VALUE "InternalName", "Murmuration"
            VALUE "LegalCopyright", "Apache License 2.0 - github.com/charlie-f/Murmuration"
            VALUE "OriginalFilename", "Murmuration.scr"
            VALUE "ProductName", "Murmuration"
            VALUE "ProductVersion", MURMURATION_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The web app (../web), generated by embed-web.ps1 at build time
#include "web_files.rc"
